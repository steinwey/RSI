# Copy to .env. RSI loads .env without overriding variables already set in the shell.
# Do not commit .env.

# Active experiment configs use Qwen Token Plan.
QWEN_TOKEN_PLAN_API_KEY=

# Optional Weights & Biases upload (rsi run --wandb)
WANDB_API_KEY=

# Optional providers, used only when their config is explicitly selected.
OPENCODE_API_KEY=
DEEPSEEK_API_KEY=
